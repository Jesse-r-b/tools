#!/usr/bin/env python3
"""Launcher that works from any directory without installing anything.

Debian's Python is PEP 668 "externally managed", so `pip install -e .` refuses
to run without a virtualenv. There is no need for one here: PySide6 and pyserial
are the only dependencies and both are already importable. This script just puts
the repository on sys.path and starts the application.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

missing = []
try:
    import PySide6  # noqa: F401
except ImportError:
    missing.append("PySide6")
try:
    import serial  # noqa: F401
except ImportError:
    missing.append("pyserial")

if missing:
    names = " ".join(missing)
    sys.exit(
        f"Missing dependencies: {names}\n\n"
        f"Install them for your user without touching the system Python:\n"
        f"    pip install --user {names}\n"
        f"or, if that is also refused:\n"
        f"    python3 -m venv --system-site-packages .venv\n"
        f"    .venv/bin/pip install {names}\n"
        f"    .venv/bin/python -m v800\n"
    )

from v800.__main__ import main  # noqa: E402

raise SystemExit(main())
